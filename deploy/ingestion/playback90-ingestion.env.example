# Copy to /etc/playback90/ingestion.env and chmod 600.
ENVIRONMENT=production

R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY=replace_me
R2_SECRET_KEY=replace_me
R2_BUCKET=replace_me

# Required when the five European leagues are enabled; MLS does not use it.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_SCHEDULE_CACHE_DIR=/var/lib/playback90/schedule-cache

# Optional. Create a Discord channel webhook to receive one message for every
# successful ingestion, existing R2 object, and failed attempt/retry.
PLAYBACK90_DISCORD_WEBHOOK_URL=

# Start the pilot with MLS and an isolated R2 namespace. Change the prefix to
# an empty value only after the first remote scrape has been verified.
PLAYBACK90_LEAGUE_SEASONS=mls:2026
PLAYBACK90_R2_KEY_PREFIX=ingestion-test
PLAYBACK90_WORKER_STATE_DB=/var/lib/playback90/state.db
PLAYBACK90_WORKER_LOCK=/var/lib/playback90/worker.lock

HOME=/var/lib/playback90
TMPDIR=/var/lib/playback90/tmp
PYTHONUNBUFFERED=1
