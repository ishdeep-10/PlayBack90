# Template for the API container's production env file on the Lightsail server.
# Real file lives only at ~ubuntu/api.env.production on the server — never commit real values.
APP_ENV=production
ENVIRONMENT=production
FRONTEND_URL=https://playback90.com
API_BASE_URL=https://playback90.com/api
AUTH_REQUIRED=true
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
# Empty on purpose: open sign-up, no invite allowlist. Set to restrict access again.
AUTH_ALLOWED_EMAILS=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
FOOTBALL_DATA_API_KEY=
X_APISPORTS_KEY=
OPPOSITION_ANALYSIS_ENABLED=false
LIVE_SCRAPE_ENABLED=false
LIVE_SCRAPE_RATE_LIMIT_PER_MINUTE=3
# Safe to reuse the same DSN as the web app's SENTRY_DSN (different Sentry project
# recommended so Python vs JS errors don't mix, but not required).
SENTRY_DSN=
# ANTHROPIC_API_KEY intentionally omitted: AI insights fall back to the
# deterministic path at $0 cost when unset.
# DATABASE_URL / REDIS_URL intentionally omitted: no Postgres/Redis deployed;
# job stores are in-memory. /ready will show database:false accordingly.
