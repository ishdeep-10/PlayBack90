# Template for the web container's runtime env file on the Lightsail server.
# Real file lives only at ~ubuntu/web.env.production on the server — never commit real values.
# NEXT_PUBLIC_* values are NOT here: they're baked in at Docker build time via
# --build-arg (see docs/deployment-handoff.md deploy commands), not passed at runtime.
CLERK_SECRET_KEY=
NODE_ENV=production
# Unprefixed SENTRY_DSN is read at runtime server-side (sentry.server.config.ts /
# sentry.edge.config.ts) — unlike NEXT_PUBLIC_SENTRY_DSN this does NOT need to be a
# build arg. Safe to reuse the same DSN as NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
