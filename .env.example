# PlayBack90 shared environment template.
# Copy the relevant values into provider secrets or a local .env file.

# API-Football / API-SPORTS coach fallback.
# Preferred env name; the app also accepts x-apisports-key for local compatibility.
X_APISPORTS_KEY=
API_SPORTS_TRANSFER_CACHE_DIR=
# Never commit real secrets.

APP_ENV=development
ENVIRONMENT=development

# Public app URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Database and queue
DATABASE_URL=postgresql://user:password@localhost:5432/playback90
REDIS_URL=redis://localhost:6379/0

# Auth
CLERK_SECRET_KEY=replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_me
AUTH_REQUIRED=false
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://example.clerk.accounts.dev
CLERK_AUDIENCE=
AUTH_ALLOWED_EMAILS=tester@example.com,admin@example.com
AUTH_ALLOWED_USER_IDS=

# Cloudflare R2
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY=replace_me
R2_SECRET_KEY=replace_me
R2_BUCKET=replace_me

# Optional provider keys
FOOTBALL_DATA_API_KEY=replace_me
# Leave unset for defaults: dev/local/test skips TLS verification when provider certs break local browsing; staging/prod verifies.
FOOTBALL_DATA_VERIFY_TLS=
# Optional. Defaults locally to apps/api/.cache/schedules.
FOOTBALL_DATA_SCHEDULE_CACHE_DIR=
ANTHROPIC_API_KEY=replace_me

# Product analytics and errors
NEXT_PUBLIC_POSTHOG_KEY=replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=replace_me
NEXT_PUBLIC_SENTRY_DSN=replace_me

# Notifications
DISCORD_WEBHOOK_URL=replace_me
