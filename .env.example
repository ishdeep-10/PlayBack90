# PlayBack90 shared environment template.
# Copy the relevant values into provider secrets or a local .env file.
# Never commit real secrets.

APP_ENV=development
ENVIRONMENT=development

# Public app URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Database and queue
DATABASE_URL=postgresql://user:password@localhost:5432/playback90
REDIS_URL=redis://localhost:6379/0

# Auth
CLERK_SECRET_KEY=replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_me
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://example.clerk.accounts.dev
AUTH_ALLOWED_EMAILS=tester@example.com,admin@example.com

# Cloudflare R2
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY=replace_me
R2_SECRET_KEY=replace_me
R2_BUCKET=replace_me

# Optional provider keys
FOOTBALL_DATA_API_KEY=replace_me
ANTHROPIC_API_KEY=replace_me

# Product analytics and errors
NEXT_PUBLIC_POSTHOG_KEY=replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=replace_me
NEXT_PUBLIC_SENTRY_DSN=replace_me

# Notifications
DISCORD_WEBHOOK_URL=replace_me
